# copy to .env — never commit .env
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant server (docker compose up -d qdrant). Leave QDRANT_PATH empty to use the server;
# set QDRANT_PATH=./qdrant_local to use embedded file mode instead (single process only).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PATH=
QDRANT_COLLECTION=medibot_chunks

# auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_HOURS=8

# retrieval knobs (defaults are fine to start; tuned on the eval set later)
CHUNK_MAX_TOKENS=200
CANDIDATES_K=10
TOP_N=3
RERANK_MIN_SCORE=-3.0

# observability: one JSON line per request is printed; set a path to also write them to a file
MEDIBOT_LOG_FILE=logs/medbud.jsonl
MEDIBOT_API_URL=http://localhost:8000
NEARBY_TOPICS_FLOOR=-10.5
